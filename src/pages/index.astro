---
/**
 * Homepage, on the harvey.ai structure.
 *
 * The reference anchors every section with something to look at. With no
 * software to screenshot, that is the destination artwork: a row of
 * scenes under the hero, full-bleed art behind the statement band.
 *
 * Still deliberately absent, because they cannot be filled honestly:
 *  - a client-logo wall. No logos exist to show; plain facts carry that
 *    space instead.
 *  - a customer testimonial. No real quote exists, and writing one for
 *    ourselves would be worse than the gap.
 *
 * Every figure comes from the destinations collection via networkCounts()
 * — see src/lib/counts.ts. The public country figure is still an open
 * question (CLAUDE.md), but at least it is one number everywhere.
 */
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import { destArt } from '../lib/landmark/generator';
import { PROCESS } from '../lib/process';
import { SERVICES } from '../lib/destinationContent';
import { networkCounts } from '../lib/counts';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';

const { countries, regions, regionCount } = await networkCounts();
const destinations = await getCollection('destinations');

/** One scene per region, so the row reads as coverage rather than decoration. */
const SCENES = [
  { name: 'Kenya', region: 'Africa' },
  { name: 'Japan', region: 'Asia' },
  { name: 'Portugal', region: 'Europe' },
  { name: 'Oman', region: 'Middle East' },
  { name: 'Mexico', region: 'North & Central America' },
  { name: 'Peru', region: 'South America' },
  { name: 'New Zealand', region: 'Australia & Oceania' },
  { name: 'Morocco', region: 'Africa' },
] as const;

const bandArt = destArt('Morocco', 'band-bg', 'dark');
---

<Base
  title="Home"
  description={`Projectour is a global destination management company. Bring us the trip and we quote it, book it and run it on the ground through vetted local operators in ${countries} countries.`}
  currentNav="home"
>
  <!-- ============ HERO ============ -->
  <section class="hx-shero">
    <div class="hx-shero-map" aria-hidden="true"><WorldMap bare /></div>
    <div class="hx hx-shero-in">
      <h1 class="hx-shero-h">Your ground operator in {countries} countries.</h1>
      <p>
        Projectour is a global destination management company. Send us the trip and we quote
        it, book it and run it on the ground, through local operators we have vetted ourselves.
      </p>
      <div class="hx-ph-cta">
        <a class="btn" href="/contact">Send a brief</a>
        <a class="btn-o" href="/destinations">See coverage</a>
      </div>
    </div>
  </section>

  <!-- ============ SCENES ============ -->
  <section class="hx" style="padding-top:clamp(28px,3.4vw,44px)">
    <div class="hx-tiles">
      {
        SCENES.map((c, i) => (
          <a class="hx-tile" href={`/destinations/${slugify(c.name)}`}>
            <span class="hx-tile-art" set:html={destArt(c.name, `hm${i}`)} />
            <span class="hx-tile-r">{c.region}</span>
            <span class="hx-tile-n">{c.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ COVERAGE ============ -->
  <section class="hx hx-sec">
    <div class="hx-mid">
      <h2>{regionCount} regions, {countries} countries</h2>
      <p>One point of contact, wherever your travellers are going.</p>
    </div>
    <div class="hx-rows">
      {
        regions.map((r, i) => (
          <a class="hx-row hx-row-link" href={`/regions/${slugify(r)}`}>
            <div class="hx-row-n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{r}</h3>
            <p class="hx-row-b">
              {destinations.filter((d) => d.data.region === r).length} countries with vetted
              operators
            </p>
            <div class="hx-row-t">View region &rarr;</div>
          </a>
        ))
      }
    </div>
    <p style="margin:clamp(28px,3.4vw,44px) 0 0">
      <a class="btn" href="/destinations">Check a country on the map</a>
    </p>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="hx hx-sec">
    <div class="hx-two" style="margin-bottom:clamp(34px,4vw,60px)">
      <h2>What we handle</h2>
      <p>
        Everything between your client saying yes and coming home. You keep the client
        relationship and your margin. We do the rest, in the destination.
      </p>
    </div>
    <div class="hx-grid">
      {
        SERVICES.map(([title, body], i) => (
          <div>
            <div class="hx-cell-n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ STATEMENT BAND ============ -->
  <section class="hx-band">
    <div class="hx-band-art" aria-hidden="true" set:html={bandArt} />
    <div class="hx hx-band-in">
      <span class="hx-band-tag">The whole point</span>
      <h2>One operator to brief, wherever the trip goes.</h2>
      <p>
        No cold outreach in a country you have never sold. No unassessed quotes at rates you
        cannot sanity-check. One brief, one net rate, one team on the ground.
      </p>
      <a class="btn" href="/how">See how it works</a>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="hx hx-sec">
    <div class="hx-split">
      <div>
        <h2 class="hx-split-h">From brief to report, in {PROCESS.length} steps</h2>
        <div class="hx-list" id="step-list">
          {
            PROCESS.map((s, i) => (
              <div class:list={['hx-item', { on: i === 0 }]}>
                <button type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span class="hx-n">{s.n}</span>
                  <span>{s.name}</span>
                </button>
                <div class="hx-body">
                  <div class="hx-body-in">
                    <p>{s.body}</p>
                    <span class="hx-who">{s.who}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <p class="hx-split-more"><a class="hx-more" href="/how">See how it works &rarr;</a></p>
      </div>

      <div class="hx-side">
        <div class="hx-note">
          <div class="hx-note-t">Always a person</div>
          <p>
            Every step is carried by someone whose name you know. Money moves only once a person
            has confirmed it in writing, and a real problem on the ground reaches you directly,
            not a queue.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="hx-dark">
    <div class="hx hx-sec">
      <div class="hx-mid">
        <h2>What the network covers</h2>
      </div>
      <dl style="margin:0">
        <div class="hx-stat"><dt>Countries with vetted operators</dt><dd>{countries}</dd></div>
        <div class="hx-stat"><dt>Regions covered</dt><dd>{regionCount}</dd></div>
        <div class="hx-stat"><dt>Points of contact per trip</dt><dd>1</dd></div>
        <div class="hx-stat"><dt>Net rate on every quote</dt><dd>1</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script>
  // Step accordion. One item open at a time. Everything renders
  // server-side with the first step open, so this only enhances markup
  // that already works.
  const items = Array.from(document.querySelectorAll<HTMLElement>('.hx-item'));
  items.forEach((el, i) => {
    el.querySelector('button')?.addEventListener('click', () => {
      items.forEach((other, j) => {
        const on = i === j;
        other.classList.toggle('on', on);
        other.querySelector('button')?.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
    });
  });
</script>
