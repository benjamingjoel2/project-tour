---
/**
 * How it works — a trip through Projectour, brief to report.
 *
 * Six steps, each with who carries it. Amber marks the money step only.
 * It is reserved across the design system for a step a person must
 * touch, and never used decoratively.
 */
import Base from '../layouts/Base.astro';
import { destArt } from '../lib/landmark/generator';
import { PROCESS } from '../lib/process';
import { networkCounts } from '../lib/counts';

const { countries } = await networkCounts();
const bandArt = destArt('Portugal', 'how-band', 'dark');
---

<Base
  title="How it works"
  description={`Send us the brief, we quote it with the operator in the destination, re-check everything on your yes, and run the trip on the ground. Six steps, all carried by people, in ${countries} countries.`}
  currentNav="how"
>
  <!-- ============ HEAD ============ -->
  <section class="hx hx-ph">
    <p class="hx-ph-eye">The route</p>
    <h1>One brief. One quote. One team on the ground.</h1>
    <p class="hx-ph-lede">
      Every trip runs through the same {PROCESS.length} steps, whichever of the
      {countries} countries it goes to. Each one is carried by a person, and you always know which.
    </p>
    <div class="hx-ph-cta">
      <a class="btn" href="/contact">Send a brief</a>
      <a class="btn-o" href="/destinations">See coverage</a>
    </div>
  </section>

  <!-- ============ STEPS ============ -->
  <section class="hx hx-sec">
    <div class="hx-rows">
      {
        PROCESS.map((s) => (
          <div class:list={['hx-row', { human: s.name === 'Book' }]}>
            <div class="hx-row-n">{s.n}</div>
            <h3>{s.name}</h3>
            <p class="hx-row-b">{s.body}</p>
            <div class="hx-row-t">{s.who}</div>
          </div>
        ))
      }
    </div>
    <div class="hx-note" style="margin-top:clamp(30px,3.6vw,52px)">
      <div class="hx-note-t">Money &middot; always confirmed</div>
      <p>
        Deposits, balances and supplier payments are confirmed by a person, in writing, every
        time. Nothing about money happens silently, and nothing is booked on a stale quote.
      </p>
    </div>
  </section>

  <!-- ============ WHAT YOU KEEP ============ -->
  <section class="hx hx-sec">
    <div class="hx-two" style="margin-bottom:clamp(34px,4vw,60px)">
      <h2>What stays yours</h2>
      <p>
        We are the operator behind your trip, not a name on it. The client sees you.
      </p>
    </div>
    <div class="hx-grid">
      <div>
        <div class="hx-cell-n">01</div>
        <h3>The client</h3>
        <p>
          Every voucher, contact and message in the destination is on your behalf. Your client
          never needs to know who is behind it.
        </p>
      </div>
      <div>
        <div class="hx-cell-n">02</div>
        <h3>The margin</h3>
        <p>
          We quote a net rate. Your markup sits on top, and the operator never sees what you
          charge. Net pricing never reaches the traveller.
        </p>
      </div>
      <div>
        <div class="hx-cell-n">03</div>
        <h3>The decision</h3>
        <p>
          Anything that changes what was sold comes back to you as a specific question with
          the options already gathered. Nothing is decided for you.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ BAND ============ -->
  <section class="hx-band">
    <div class="hx-band-art" aria-hidden="true" set:html={bandArt} />
    <div class="hx hx-band-in">
      <span class="hx-band-tag">The whole point</span>
      <h2>Say yes to the destination before you know how you will deliver it.</h2>
      <p>You already have the operator. Send the brief.</p>
      <a class="btn" href="/contact">Send a brief</a>
    </div>
  </section>
</Base>
