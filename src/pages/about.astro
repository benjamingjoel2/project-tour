---
/**
 * About, on the site's shared page patterns.
 *
 * Not built, because filling them would mean inventing things:
 *
 *  - an investor grid. Whether Projectour has raised, and from whom, is
 *    not something this repository knows.
 *  - a press or awards section. The two badges carried over from the old
 *    site are flagged in CLAUDE.md as unverified, and an awards block is
 *    where an unverified claim does the most damage.
 *  - a customer testimonial. There is no real quote. The pull quote here
 *    is the company in its own voice, attributed as such.
 *
 * "Name pending" stays on the three team cards, visible rather than
 * quietly filled in, and the page stays noindex until they are real.
 */
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../lib/contact';
import { destArt } from '../lib/landmark/generator';
import { networkCounts } from '../lib/counts';
import { PROCESS } from '../lib/process';

const { countries, regionCount } = await networkCounts();

const BAND = ['Kenya', 'Peru', 'Japan', 'Morocco', 'Portugal'];
const bandArt = BAND.map((name) => ({ name, svg: destArt(name, `ab-${name}`) }));

const TEAM = ['Founder / CEO', 'Co-founder / Operations', 'Co-founder / Partnerships'];
---

<Base
  title="About"
  description="Projectour is a global destination management company, built by people who have run trips on the ground the hard way — one operator, one brief, one team in the destination."
  currentNav="about"
  noindex
>
  <section class="hx hx-ph">
    <p class="hx-ph-eye">Company</p>
    <h1>We used to source this by hand too.</h1>
  </section>

  <section class="hx">
    <div class="hx-ab-stats">
      <div><b>{countries}</b><span>Countries with vetted operators</span></div>
      <div><b>{regionCount}</b><span>Regions covered</span></div>
      <div><b>{PROCESS.length}</b><span>Steps in every trip we run</span></div>
    </div>
  </section>

  <section class="hx-ab-band" aria-label="Where we operate">
    <div class="hx-ab-strip">
      {
        bandArt.map((a) => (
          <figure class="hx-ab-fig">
            <div set:html={a.svg} />
            <figcaption>{a.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="hx hx-sec">
    <div class="hx-two">
      <h2>Why we exist</h2>
      <div>
        <p>
          Projectour was started by people who had sold trips the old way: deep operator
          relationships in a handful of countries, and cold emails to strangers everywhere
          else. Every out-of-region inquiry meant guessing at an operator you could not
          assess, at a rate you could not sanity-check, days after the client asked.
        </p>
        <p>
          So we built the thing we wished we had. One destination management company with
          vetted local operators in {countries} countries across {regionCount} regions.
          You send the brief. We quote it, book it and run it on the ground. You keep the
          client and the margin.
        </p>
      </div>
    </div>
  </section>

  <section class="hx hx-sec">
    <blockquote class="hx-ab-quote">
      <p>A good operator's best work is invisible. It shows up as an absence of problems.</p>
      <cite>Projectour</cite>
    </blockquote>
  </section>

  <section class="hx hx-sec">
    <div class="hx-two" style="margin-bottom:clamp(30px,3.6vw,52px)">
      <h2>The team</h2>
      <p>Names and bios are still being finalised. This page is hidden from search until they are.</p>
    </div>
    <div class="hx-ab-team">
      {
        TEAM.map((role) => (
          <div class="hx-ab-person">
            <div class="hx-ab-av" />
            <div class="hx-ab-role">{role}</div>
            <h3>Name pending</h3>
            <p>Placeholder bio — replace before this page goes live publicly.</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="hx hx-sec">
    <h2 class="hx-ab-join">
      Join our team. <span>Help run trips in more places, better.</span>
    </h2>
    <a class="btn" href={`mailto:${CONTACT_EMAIL}?subject=Working%20at%20Projectour`}>Get in touch</a>
  </section>
</Base>
