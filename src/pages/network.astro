---
/**
 * The network — the vetted local operators Projectour runs trips through.
 *
 * Same structure as the rest of the site: page head, a coverage row,
 * region rows, the positioning columns, and the note for operators.
 * Country and region figures come from networkCounts(), never from copy.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { networkCounts } from '../lib/counts';
import { slugify } from '../lib/slug';
import { destArt } from '../lib/landmark/generator';
import { CONTACT_EMAIL } from '../lib/contact';

const { countries, regions, regionCount } = await networkCounts();
const destinations = await getCollection('destinations');

/** Each region, with the number of countries actually in it. */
const REGION_ROWS = regions.map((region) => ({
  region,
  href: `/regions/${slugify(region)}`,
  count: destinations.filter((d) => d.data.region === region).length,
}));

/** One scene per region, so the row reads as coverage rather than decoration. */
const COVERAGE = [
  { name: 'Kenya', region: 'Africa' },
  { name: 'Japan', region: 'Asia' },
  { name: 'New Zealand', region: 'Australia & Oceania' },
  { name: 'Portugal', region: 'Europe' },
  { name: 'Oman', region: 'Middle East' },
  { name: 'Mexico', region: 'North & Central America' },
  { name: 'Peru', region: 'South America' },
  { name: 'Morocco', region: 'Africa' },
] as const;

const bandArt = destArt('Morocco', 'nw-band', 'dark');
const operatorMail = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Joining the Projectour network')}`;
---

<Base
  title="The network"
  description={`Vetted local operators in ${countries} countries across ${regionCount} regions — relationships Projectour runs trips through directly, not a directory.`}
  currentNav="network"
>
  <!-- ============ HEAD ============ -->
  <section class="hx hx-ph">
    <p class="hx-ph-eye">The network</p>
    <h1>Operators we have run trips through ourselves.</h1>
    <p class="hx-ph-lede">
      Projectour's coverage is a network of local ground operators in {countries} countries,
      each one vetted by us and used on real trips. Bring us the trip and we run it through
      them for you.
    </p>
    <div class="hx-ph-cta">
      <a class="btn" href="/contact">Send a brief</a>
      <a class="btn-o" href="/destinations">See every country</a>
    </div>
  </section>

  <!-- ============ COVERAGE ============ -->
  <section class="hx">
    <div class="hx-tiles">
      {
        COVERAGE.map((c, i) => (
          <a class="hx-tile" href={`/destinations/${slugify(c.name)}`}>
            <span class="hx-tile-art" set:html={destArt(c.name, `nwcv${i}`)} />
            <span class="hx-tile-r">{c.region}</span>
            <span class="hx-tile-n">{c.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ REGIONS ============ -->
  <section class="hx hx-sec">
    <div class="hx-two" style="margin-bottom:clamp(34px,4vw,60px)">
      <h2>{regionCount} regions, {countries} countries</h2>
      <p>
        Every country has its own page, and every region its own list.
      </p>
    </div>
    <div class="hx-rows">
      {
        REGION_ROWS.map((r, i) => (
          <a class="hx-row hx-row-link" href={r.href}>
            <div class="hx-row-n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{r.region}</h3>
            <p class="hx-row-b">{r.count} countries with vetted operators</p>
            <div class="hx-row-t">View region &rarr;</div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ POSITIONING ============ -->
  <section class="hx hx-sec">
    <div class="hx-grid">
      <div>
        <div class="hx-cell-n">01</div>
        <h3>The gap</h3>
        <p>
          Most agencies have deep operator relationships in a handful of destinations. The
          moment a client asks for somewhere outside that list, the process reverts to cold
          outreach and guesswork. The network exists so that gap never reaches your customer.
        </p>
      </div>
      <div>
        <div class="hx-cell-n">02</div>
        <h3>Not a marketplace</h3>
        <p>
          These are relationships Projectour operates trips through directly, not a directory
          of unverified contacts. Every trip is evidence of how an operator behaves when
          something breaks, and that record decides who stays in the network.
        </p>
      </div>
      <div>
        <div class="hx-cell-n">03</div>
        <h3>How we vet</h3>
        <p>
          Licences, insurance and fleet checked before the first trip. The first trips watched
          closely. Operators who quietly downgrade, go silent in a crisis or contact travellers
          with their own pricing do not get a second.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ BAND ============ -->
  <section class="hx-band">
    <div class="hx-band-art" aria-hidden="true" set:html={bandArt} />
    <div class="hx hx-band-in">
      <span class="hx-band-tag">For operators</span>
      <h2>Real trips from agencies already selling your destination.</h2>
      <p>
        Structured briefs from agencies actively planning trips where you operate, not cold
        outreach. Tell us where you work and what you run.
      </p>
      <a class="btn" href={operatorMail}>Join the network</a>
    </div>
  </section>
</Base>
