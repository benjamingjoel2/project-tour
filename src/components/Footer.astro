---
import { CONTACT_EMAIL } from '../lib/contact';
/**
 * Footer, on the Harvey AI reference layout:
 *
 *   1. a CTA band  — headline left, one button right
 *   2. a rule
 *   3. the mark and contact details on the left, link columns on the right
 *   4. copyright and legal links along the bottom
 *
 * The "Follow" column's hrefs are still the placeholder "#" they always
 * were — real profile URLs are still needed. There is no FAQ link because
 * no FAQ page exists; a dead control is worse than an honest omission.
 */
const YEAR = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="f-cta">
      <h2>Bring us your next trip.</h2>
      <a class="f-pill" href="/contact">Send a brief</a>
    </div>

    <div class="f-hr"></div>

    <div class="f-main">
      <div class="f-brand">
        <a class="f-mark" href="/" aria-label="Projectour — home">
          <svg viewBox="0 0 100 100" aria-hidden="true"
            ><circle class="ring" cx="50" cy="50" r="44"></circle><rect x="32.5" y="26" width="7.5" height="47"
            ></rect><rect x="60" y="26" width="7.5" height="47"></rect><rect
              x="32.5"
              y="46.5"
              width="35"
              height="7.5"></rect></svg
          >
        </a>
        <div class="f-con">
          <div>Intelak Hub, Offices 4, One Central<br />Dubai World Trade Center, Dubai, UAE</div>
          <div><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></div>
        </div>
      </div>

      <nav class="f-cols" aria-label="Footer">
        <div class="f-col">
          <h4>Services</h4>
          <a href="/destinations">Destinations</a>
          <a href="/how">How it works</a>
          <a href="/network">The network</a>
        </div>
        <div class="f-col">
          <h4>Company</h4>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
        </div>
        <div class="f-col">
          <h4>Follow</h4>
          <a href="#">X</a>
          <a href="#">Instagram</a>
          <a href="#">YouTube</a>
        </div>
      </nav>
    </div>

    <div class="f-bottom">
      <span class="f-copy">Copyright &copy; {YEAR} Projectour. All rights reserved.</span>
      <a href="/terms">Terms &amp; Conditions</a>
      <a href="/privacy">Privacy Policy</a>
    </div>
  </div>

  <div class="f-word" aria-hidden="true">
    <div class="tr">
      <span>projectour. &mdash; projectour. &mdash;&nbsp;</span><span
        >projectour. &mdash; projectour. &mdash;&nbsp;</span
      >
    </div>
  </div>
</footer>
